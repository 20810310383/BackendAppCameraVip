PORT=4000
# MongoDB Atlas hoặc MongoDB local.
MONGODB_URI=mongodb://127.0.0.1:27017/boardverse
# Dùng * khi phát triển. Khi production hãy điền domain của app/web admin.
CORS_ORIGIN=*
# Public URL used for links shared outside the app. Leave blank in local
# development to derive it from the incoming request host.
PUBLIC_APP_URL=https://cameradaily.top

# Email gửi OTP. Với Gmail, EMAIL_PASS nên là App Password 16 ký tự.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
# The app owner receives a notification after an account is permanently deleted.
ACCOUNT_DELETION_NOTIFICATION_EMAIL=dokhactu1802@gmail.com

# Comma-separated OAuth client IDs whose Google ID tokens this API accepts.
# Normally this is the Web client ID used by the mobile app.
GOOGLE_OAUTH_CLIENT_IDS=

# Comma-separated Apple client IDs that this API accepts. For the native iOS
# app, use its bundle identifier. Apple generates a private relay email when a
# user selects "Hide My Email"; it is supported by the /api/auth/apple route.
APPLE_OAUTH_CLIENT_IDS=com.cameradaily.app

# Optional: required only when "Push security" is enabled for the EAS project.
# Create an Expo access token and keep it on the backend; never put it in the app.
EXPO_ACCESS_TOKEN=

# Cloudflare R2 (S3-compatible object storage). Leave all five blank for local
# development. In production they must either all be set or all be absent.
# The public base URL is the bucket's public development URL or custom domain,
# for example: https://media.example.com
R2_ENDPOINT=https://96f5f2ce232dff1675c49f7aca18de18.r2.cloudflarestorage.com
R2_BUCKET=app-cameradaily-media-prod
R2_ACCESS_KEY_ID=34147c5e24561a6c8e33893024cf3c2e
R2_SECRET_ACCESS_KEY=1138ee39d71c56a6c08c9994e5927ee3e148595400f8dec97cb0797413f0e940
R2_PUBLIC_BASE_URL=https://media.cameradaily.top
